            <ui:Label tabindex="-1" text="监听者列表" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Title3" style="-unity-text-align: middle-center; width: 70%; height: 10%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-bottom-width: 1.5px; border-left-color: rgb(38, 38, 38); border-right-color: rgb(38, 38, 38); border-top-color: rgb(38, 38, 38); border-bottom-color: rgb(38, 38, 38); font-size: 19px; color: rgb(255, 255, 255);" />
