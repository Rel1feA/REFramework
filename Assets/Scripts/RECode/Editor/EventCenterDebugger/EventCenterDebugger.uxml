    <ui:VisualElement name="root" style="flex-grow: 1; background-color: rgb(64, 64, 64); flex-direction: column;">
        <ui:VisualElement name="Top" style="flex-grow: 0; border-bottom-width: 1.5px; border-left-color: rgb(38, 38, 38); border-right-color: rgb(38, 38, 38); border-top-color: rgb(38, 38, 38); border-bottom-color: rgb(38, 38, 38); flex-direction: row; height: auto; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;">
            <ui:Label tabindex="-1" text="事件中心调试页面" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Title" style="-unity-text-align: middle-center; -unity-font-style: bold; color: rgb(255, 255, 255); font-size: 19px; -unity-font: url(&apos;project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&apos;); flex-grow: 1; padding-left: 2px; margin-left: 2px; margin-bottom: 2px; margin-top: 2px; margin-right: 2px;" />
